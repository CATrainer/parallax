# ─────────────────────────────────────────────────────────────
# Parallax environment. Copy to `.env` and fill what you have.
# The app RUNS LOCALLY WITH ZERO KEYS on seed data. Keys turn
# adapters / live AI on. See README "Setup & API keys".
# ─────────────────────────────────────────────────────────────

# Core (local docker-compose defaults; override in prod)
DATABASE_URL=postgresql+asyncpg://parallax:parallax@localhost:5435/parallax
REDIS_URL=redis://localhost:6380/0
ENVIRONMENT=local
LOG_LEVEL=INFO

# Run mode: SEED keeps adapters in mock/seed mode; LIVE enables real fetches.
# Per-adapter override below takes precedence over this default.
DATA_MODE=SEED

# ── AI / synthesis ────────────────────────────────────────────
# If ANTHROPIC_API_KEY is unset, synthesis uses the deterministic
# template fallback so briefings still render offline.
INFERENCE_PROVIDER=anthropic            # anthropic | openai | template
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_PREMIUM=claude-opus-4-8
OPENAI_API_KEY=

# ── Data source adapters (all optional for local seed run) ────
# Companies House: free key from developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=
# Geocoder (address↔UPRN). postcodes.io is free/keyless and used by default.
GEOCODER_PROVIDER=postcodes_io          # postcodes_io | ideal_postcodes | postcoder
IDEAL_POSTCODES_API_KEY=
POSTCODER_API_KEY=
# EPC register (free account): get-energy-performance-data.communities.gov.uk
# Auth = the "Bearer token (for developers)" from your EPC account page. Paste it here;
# no email needed (the adapter sends `Authorization: Bearer <token>`).
EPC_AUTH_TOKEN=
EPC_EMAIL=
EPC_API_KEY=
# HMLR (free account + licence) — used in validation title pulls
HMLR_API_KEY=

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_MIN=10080

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8003
